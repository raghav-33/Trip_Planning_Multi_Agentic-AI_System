Recommended Folder Structure
evaluation/
│
├── __init__.py
├── schemas.py
├── prompts.py
├── evaluator.py          # orchestrates all evaluations
│
├── supervisor.py
├── flight.py
├── hotel.py
├── weather.py
├── budget.py
├── itinerary.py
└── final_response.py
Common Schema (schemas.py)

Every evaluator returns the same object.

from pydantic import BaseModel, Field


class AgentEvaluation(BaseModel):
    agent_name: str

    score: int = Field(..., ge=1, le=10)

    strengths: list[str]

    weaknesses: list[str]

    reasoning: str
Example: Flight Evaluator
from langchain_core.prompts import ChatPromptTemplate

from config import get_llm
from evaluation.schemas import AgentEvaluation

llm = get_llm().with_structured_output(AgentEvaluation)

prompt = ChatPromptTemplate.from_template(
"""
You are evaluating the Flight Agent.

User Query:
{query}

Trip Constraints:
{constraints}

Flight Agent Output:
{output}

Evaluate:

1. Airport correctness

2. Airline relevance

3. Travel practicality

4. Budget awareness

Give score out of 10.

Return structured output.
"""
)


def evaluate_flight_agent(
    query,
    constraints,
    output,
):

    messages = prompt.invoke(
        {
            "query": query,
            "constraints": constraints,
            "output": output,
        }
    )

    return llm.invoke(messages)
